{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neo:contract:AuditEvent:1.0.0",
  "title": "AuditEvent",
  "x-neo-contract-version": "1.0.0",
  "x-neo-semantic-owner": "System Authority schema; producer-authored, AUD-001 appends/orders",
  "x-neo-invariant": "Producer submission proves only what the producer reported; AUD owns append order/time; external truth requires evidence/reconciliation lineage.",
  "allOf": [
    {
      "$ref": "urn:neo:contract:RecordEnvelope:1.0.0"
    },
    {
      "type": "object",
      "required": [
        "event_id",
        "event_schema_version",
        "event_type",
        "actor_module",
        "subject_refs",
        "authority_refs_if_relevant",
        "truth_refs_if_relevant",
        "payload_ref_or_summary",
        "payload_digest",
        "data_classification",
        "producer_emitted_at",
        "producer_clock_quality"
      ],
      "properties": {
        "contract_name": {
          "const": "AuditEvent"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "event_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "event_schema_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "event_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127,
          "pattern": "^[A-Z][A-Z0-9_]{0,126}$"
        },
        "actor_module": {
          "type": "string",
          "pattern": "^NEO-[A-Z][A-Z0-9]*-[0-9]{3}$"
        },
        "subject_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "authority_refs_if_relevant": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "truth_refs_if_relevant": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "payload_ref_or_summary": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "payload_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "additionalProperties": false,
              "required": [
                "payload_ref"
              ]
            },
            {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "additionalProperties": false,
              "required": [
                "summary"
              ]
            }
          ]
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data_classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127,
          "pattern": "^[A-Z][A-Z0-9_]{0,126}$"
        },
        "producer_occurred_at_if_known": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "producer_emitted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "producer_clock_quality": {
          "enum": [
            "SYNCHRONIZED",
            "ESTIMATED",
            "UNSYNCHRONIZED",
            "UNKNOWN"
          ]
        },
        "producer_signature_ref_if_used": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "x-neo-semantic-validators": [
    "AUDIT_EVENT_PAYLOAD_DIGEST_MATCH",
    "AUDIT_EVENT_EXTERNAL_TRUTH_REQUIRES_TRUTH_REFS",
    "AUDIT_EVENT_NO_PRIVATE_CHAIN_OF_THOUGHT",
    "AUDIT_LEDGER_ORDER_ASSIGNED_BY_AUD"
  ]
}
